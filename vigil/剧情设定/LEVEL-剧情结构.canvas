		{"id":"e00002c","fromNode":"g000009","fromSide":"right","fromEnd":"none","toNode":"g00000e","toSide":"left","toEnd":"arrow","label":"落点"},
		{"id":"e00002d","fromNode":"g000012","fromSide":"top","fromEnd":"none","toNode":"g000005","toSide":"bottom","toEnd":"arrow","label":"法则三 → 铭火永不失"},
		{"id":"e00002e","fromNode":"g000018","fromSide":"top","fromEnd":"none","toNode":"g000009","toSide":"bottom","toEnd":"arrow","label":"守夜人说日循环"},
