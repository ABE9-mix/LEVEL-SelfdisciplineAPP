{
  "nodes": [
    {
      "id": "s01",
      "type": "text",
      "text": "星港计划 · 系统结构图\n（机制怎么互相喂 ／ 与 IA 图分工：IA 管页面，本图管关系）",
      "x": -380.0,
      "y": -160.0,
      "width": 1080.0,
      "height": 64.0,
      "color": "6"
    },
    {
